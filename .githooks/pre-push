#!/usr/bin/env bash
# Pre-push hook: validation before pushing to remote.
set -e

echo "==> Checking headless gateway build..."
cargo check -p gateway --no-default-features

echo "==> Running Clippy on workspace..."
CARGO_BUILD_WARNINGS=deny cargo clippy --workspace --all-targets --all-features

if command -v cargo-deny >/dev/null 2>&1; then
    echo "==> Running cargo deny check..."
    # Errors only; CI prints the full warning report.
    cargo deny --log-level error check
else
    echo "==> cargo-deny not installed; skipping the license and advisory check."
fi

echo "==> Pre-push checks passed successfully."
